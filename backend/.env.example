# Copy to .env and adjust as needed. All values are optional -- sensible
# local defaults are used if unset (see app/config.py).

# Storage backend: "local" (default) or "s3"
LUNAR_STORAGE_BACKEND=local
LUNAR_S3_BUCKET=
LUNAR_S3_REGION=

# AWS credentials (only needed if LUNAR_STORAGE_BACKEND=s3) -- read by
# boto3 from the standard environment variables, never hard-coded:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: enables Lunar AI's fluent-narrative enhancement step via the
# Anthropic API. If unset, Lunar AI still works fully using its built-in
# rule-based scientific interpretation engine.
ANTHROPIC_API_KEY=

# CORS origins allowed to call this API, comma-separated.
LUNAR_CORS_ORIGINS=*
